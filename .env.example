# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENAI_API_KEY="MY_OPENAI_API_KEY"
OPENAI_MODEL="gpt-4o-mini"

# Precedentes vectoriales (server.ts): PostgREST + service role para insert/RPC.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service_role_xxxx"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SGDE (server.ts): lectura de árbol y vinculación por radicado; credenciales solo en servidor.
# SGDE_USER es alias de SGDE_USERNAME.
SGDE_USERNAME=""
SGDE_PASSWORD=""
# SGDE_BASE_URL="https://siugj-sgde.ramajudicial.gov.co"
# SGDE_ENABLED=0
# Solo diagnóstico si hay errores TLS: SGDE_TLS_INSECURE=1
