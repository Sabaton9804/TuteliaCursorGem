# --- Inteligencia artificial (raíz del proyecto: .env o .env.local junto a server.ts) ---
#
# IMPORTANTE (Tutelia hoy): resúmenes, análisis de piezas, correo judicial y radicación
# usan OpenAI en el servidor. GEMINI_API_KEY está en plantilla por herencia del proyecto;
# no la lee server.ts en las funciones actuales.
#
# Si solo va a usar Tutelia: configure OPENAI_API_KEY (obligatorio para IA).
# Clave en: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-xxxxxxxx"
OPENAI_MODEL="gpt-4o-mini"
#
# Gemini: Llamada 1 al indexar precedentes PDF (extracción larga del fallo). Llamada 2 sigue en OpenAI.
# Obtener clave: https://aistudio.google.com/apikey
GEMINI_API_KEY="AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Lectura rápida por pieza en expediente digital (máx. páginas PDF enviadas a IA)
# AI_PIECE_MAX_PAGES=40
# Solo si Node falla TLS hacia OpenAI (proxy/antivirus): OPENAI_TLS_INSECURE=1
# OPENAI_TLS_INSECURE=1

# Frontend (Vite): cliente Supabase en navegador — clave «anon» publicable (sin espacio tras «=»).
VITE_SUPABASE_URL="https://xxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Servidor y scripts (verify:supabase): misma URL y anon; service_role solo en Node.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="service_role_xxxx"
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY — opcional, mismos valores
# Si Node falla TLS hacia Supabase en Windows: OPENAI_TLS_INSECURE=1 (server.ts y verify:supabase)

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Producción (Cloud Run): NODE_ENV=production — Express sirve dist/ + /api/*.
# Comando de arranque: npm start  (tsx server.ts). No usar vite preview ni node server.ts.
# Tras deploy, verifique https://SU-URL/api/health → {"status":"ok"}.
# PORT lo asigna Cloud Run; local default 3451 (ver server.ts).

# Puerto del servidor dev (Express + Vite). Por defecto 3451 si no hay PORT.
# PORT=3451

# Outlook / Microsoft Graph (server.ts): OAuth delegado + buzones compartidos (v0.4).
# Permisos delegados en Entra: Mail.Read.Shared, Mail.ReadWrite.Shared, Mail.Send.Shared
#   y (piloto /me) Mail.Read, Mail.ReadWrite, Mail.Send, offline_access, User.Read, openid, profile, email.
# Admin consent en el tenant de la Rama Judicial.
# Redirect URI: http://localhost:3000/api/outlook/callback (o APP_URL + /api/outlook/callback en producción).
# OUTLOOK_CLIENT_ID=""
# OUTLOOK_CLIENT_SECRET=""
# OUTLOOK_TENANT_ID="common"
# OUTLOOK_REDIRECT_URI="http://localhost:3000/api/outlook/callback"
# OUTLOOK_ENABLED=0
# OUTLOOK_STATE_SECRET=""  # opcional; por defecto usa SUPABASE_SERVICE_ROLE_KEY
# OUTLOOK_ALLOW_LEGACY_ME=1          # 1 = permite /me si no hay court_mailboxes o sin selector
# OUTLOOK_REQUIRE_EXPLICIT_MAILBOX=1 # 1 = exige buzón compartido cuando el despacho está configurado
# OUTLOOK_OAUTH_PROMPT=consent       # en producción omitir o OUTLOOK_OAUTH_PROMPT=select_account
# Seed buzón piloto: COURT_MAILBOX_UPN="juzgado@ramajudicial.gov.co" npm run seed:court-mailboxes

# SGDE: cada usuario guarda su usuario/contraseña en Ajustes (tabla sgde_credentials, cifrado en servidor).
# Clave de cifrado (NO es la contraseña SGDE de nadie):
SGDE_CREDENTIALS_KEY=""
# SGDE_BASE_URL="https://siugj-sgde.ramajudicial.gov.co"
# SGDE_ENABLED=0
# Si falla "unable to verify the first certificate" al validar SGDE (proxy/antivirus):
SGDE_TLS_INSECURE=1
# (También aplica si ya usa OPENAI_TLS_INSECURE=1 en el mismo .env)
# (Obsoleto) SGDE_USERNAME / SGDE_PASSWORD en .env ya no se usan.
