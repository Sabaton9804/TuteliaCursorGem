# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENAI_API_KEY="MY_OPENAI_API_KEY"
OPENAI_MODEL="gpt-4o-mini"
# Solo si Node falla TLS hacia OpenAI (proxy/antivirus): OPENAI_TLS_INSECURE=1
# OPENAI_TLS_INSECURE=1

# Frontend (Vite): cliente Supabase en navegador — usar clave «anon» publicable, no service_role.
VITE_SUPABASE_URL="https://xxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Servidor (server.ts): PostgREST + service role para precedentes/RPC e índice vectorial.
# Fragmentación (opcional): PRECEDENT_CHUNK_MAX_CHARS, PRECEDENT_CHUNK_OVERLAP_CHARS, PRECEDENT_MAX_CHUNKS
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service_role_xxxx"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Outlook / Microsoft Graph (server.ts): correo por funcionario (OAuth delegado).
# Registre una app en Microsoft Entra ID (Azure Portal) → API permissions: Mail.Read, Mail.Send, offline_access, User.Read.
# Redirect URI: http://localhost:3000/api/outlook/callback (o APP_URL + /api/outlook/callback en producción).
# OUTLOOK_CLIENT_ID=""
# OUTLOOK_CLIENT_SECRET=""
# OUTLOOK_TENANT_ID="common"
# OUTLOOK_REDIRECT_URI="http://localhost:3000/api/outlook/callback"
# OUTLOOK_ENABLED=0
# OUTLOOK_STATE_SECRET=""  # opcional; por defecto usa SUPABASE_SERVICE_ROLE_KEY

# SGDE: cada usuario guarda su usuario/contraseña en Ajustes (tabla sgde_credentials, cifrado en servidor).
# Clave de cifrado (NO es la contraseña SGDE de nadie):
SGDE_CREDENTIALS_KEY=""
# SGDE_BASE_URL="https://siugj-sgde.ramajudicial.gov.co"
# SGDE_ENABLED=0
# Si falla "unable to verify the first certificate" al validar SGDE (proxy/antivirus):
SGDE_TLS_INSECURE=1
# (También aplica si ya usa OPENAI_TLS_INSECURE=1 en el mismo .env)
# (Obsoleto) SGDE_USERNAME / SGDE_PASSWORD en .env ya no se usan.
